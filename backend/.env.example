# Copy to .env for local development only. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_PASSWORD=replace-with-a-long-unique-password
TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# For local browser requests, include the frontend origin. Multiple origins comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
